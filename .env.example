# ---- Database ----
# PostgreSQL connection string. See docker-compose.yml to spin up Postgres locally.
DATABASE_URL="postgresql://myschool:myschool@localhost:5432/myschool?schema=public"

# ---- Auth ----
# Secret used to sign session JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# ---- App ----
NEXT_PUBLIC_APP_NAME="MySchool Connect"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Feature flags (UI is also reflected in DB; these act as env fallbacks / overrides)
FT_PARENT_CHAT="false"
FT_PAYMENTS="true"            # mock payment flow
FT_WHATSAPP="false"
FT_EMAIL_NOTIFICATIONS="true"
FT_SMS="false"
FT_TEACHERS="false"

# ---- Web Push (VAPID) ----
# Real-time OS-level push notifications to parents' browsers/devices.
# Generate a fresh pair with:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
VAPID_PUBLIC_KEY="paste-the-public-key-here"
VAPID_PRIVATE_KEY="paste-the-private-key-here"
VAPID_SUBJECT="mailto:school@myschool.edu"

# ---- Email notifications (SMTP) ----
# Leave SMTP_HOST empty to disable email sending (push/in-app still work).
SMTP_HOST=""                      # e.g. smtp.gmail.com
SMTP_PORT="587"
SMTP_SECURE="false"               # true for 465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MySchool Connect <noreply@example.com>"

# ---- OCR (optional providers) ----
# Local OCR is the default (DevelopmentOcrService). To use a real provider later,
# implement it behind OcrService and toggle the mode here.
OCR_MODE="dev"                # "dev" | "tesseract" | "google" | "azure" | "aws"
# GOOGLE_VISION_API_KEY=""
# AZURE_OCR_ENDPOINT=""
# AZURE_OCR_KEY=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION=""

# ---- AI extraction (School Communication Intelligence Agent) ----
# "dev"    = deterministic rule-based extractor (no network, no cost, works offline).
# "remote" = vision-capable LLM via ANY OpenAI-compatible chat-completions endpoint.
#            The agent reads text AND images (posters/photos) and returns structured,
#            Zod-validated JSON: categories, affected grades/classes, events vs
#            deadlines, payments, projects broken into tasks, action items with a
#            PARENT/CHILD/TEACHER assignee, detected dates (ambiguous ones stay null
#            with notes) and explicitly named people. Unknown info is never invented.
AI_MODE="dev"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"                        # must support vision to read images
AI_API_BASE_URL="https://api.openai.com/v1"   # point at Azure proxy / local model server if needed
# Legacy aliases (OPENAI_API_KEY / OPENAI_MODEL) are still honoured if AI_* are unset.
