# ---- Database ----
# PostgreSQL connection string. See docker-compose.yml to spin up Postgres locally.
DATABASE_URL="postgresql://myschool:myschool@localhost:5432/myschool?schema=public"

# ---- Auth ----
# Secret used to sign session JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# ---- App ----
NEXT_PUBLIC_APP_NAME="MySchool Connect"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Feature flags (UI is also reflected in DB; these act as env fallbacks / overrides)
FT_PARENT_CHAT="false"
FT_PAYMENTS="true"            # mock payment flow
FT_WHATSAPP="false"
FT_EMAIL_NOTIFICATIONS="false"
FT_SMS="false"
FT_TEACHERS="false"

# ---- OCR (optional providers) ----
# Local OCR is the default (DevelopmentOcrService). To use a real provider later,
# implement it behind OcrService and toggle the mode here.
OCR_MODE="dev"                # "dev" | "tesseract" | "google" | "azure" | "aws"
# GOOGLE_VISION_API_KEY=""
# AZURE_OCR_ENDPOINT=""
# AZURE_OCR_KEY=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION=""

# ---- AI extraction (optional) ----
# "dev" uses a deterministic rule-based extractor (no network, no cost, works offline).
# Set to "remote" + provide a key to use a hosted model. Either way output is Zod-validated.
AI_MODE="dev"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"