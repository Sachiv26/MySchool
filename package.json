{
  "name": "myschool-parent-connect",
  "version": "0.1.0",
  "private": true,
  "description": "Parent/school communication platform — structured reminders from WhatsApp-style school messages.",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "dayjs": "1.11.13",
    "jose": "5.9.6",
    "lucide-react": "0.451.0",
    "next": "14.2.21",
    "pdf-parse": "1.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.35.4",
    "tesseract.js": "^5.1.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "18.19.55",
    "@types/pdf-parse": "1.1.4",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.21",
    "postcss": "8.4.47",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.13",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
